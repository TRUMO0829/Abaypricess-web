# Сайтын бүтэн хаяг (metadata, sitemap, OG зурагт ашиглана)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Уулзалтын цаг захиалга (Google Calendar) — тохиргооны заавар: docs/BOOKING.md
# Бүгд хоосон бол production-д цаг захиалга нуугдаж, маягт имэйлээр ажилласаар байна.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Хоосон бол refresh token эзэмшигчийн үндсэн календарь (primary). API key горимд заавал (ж: name@gmail.com)
GOOGLE_CALENDAR_ID=
# Зөвхөн сул цаг харуулах горим (OAuth-гүй үед): public календарь + API key. Уулзалт автоматаар үүсэхгүй,
# сонгосон цаг хүсэлтийн имэйлд орно. Дээрх OAuth гурав тохируулагдвал тэр нь давуу эрхтэй.
GOOGLE_CALENDAR_API_KEY=
# 1 бол Google-гүйгээр туршилтын календарь ашиглана (e2e тест). Dev горимд автоматаар асна.
BOOKING_MOCK=

# Онлайн уулзалтын байнгын Zoom холбоос (календарийн урилга, баталгаажуулалтад орно)
ZOOM_MEETING_URL=

# Нэвтрэх (утас + нууц үг) — docs/AUTH.md. Session cookie-ийн гарын үсгийн нууц, 32+ тэмдэгт:
#   openssl rand -base64 48
AUTH_SECRET=
# 1 бол Supabase-гүйгээр санах ойн бүртгэл (e2e). Dev горимд Supabase env байхгүй бол автоматаар.
AUTH_MOCK=

# Байгууллагын үнэлгээ (/assessment) — docs/ASSESSMENT.md
SUPABASE_URL=
# Зөвхөн INSERT эрхтэй publishable key (Supabase → Project Settings → API Keys)
SUPABASE_PUBLISHABLE_KEY=
# Шинэ үнэлгээний имэйл мэдэгдэл (заавал биш)
RESEND_API_KEY=
# Хоосон бол company.contact.email; таслалаар олон хаяг
ASSESSMENT_NOTIFY_TO=
ASSESSMENT_NOTIFY_FROM=
# 1 бол Supabase-гүйгээр санах ойд хадгална (e2e). Dev горимд Supabase env байхгүй бол автоматаар.
ASSESSMENT_MOCK=
