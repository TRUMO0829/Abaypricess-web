# Сайтын бүтэн хаяг (metadata, sitemap, OG зурагт ашиглана)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Уулзалтын цаг захиалга (Google Calendar) — тохиргооны заавар: docs/BOOKING.md
# Бүгд хоосон бол production-д цаг захиалга нуугдаж, маягт имэйлээр ажилласаар байна.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Хоосон бол refresh token эзэмшигчийн үндсэн календарь (primary)
GOOGLE_CALENDAR_ID=
# 1 бол Google-гүйгээр туршилтын календарь ашиглана (e2e тест). Dev горимд автоматаар асна.
BOOKING_MOCK=
